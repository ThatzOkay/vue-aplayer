{
  "name": "@thatzokay/vue-aplayer",
  "private": false,
  "description": "A beautiful HTML5 music player for Vue.js",
  "version": "4.0.0",
  "author": "ThatzOkay",
  "license": "MIT",
  "homepage": "https://github.com/ThatzOkay/vue-aplayer#readme",
  "repository": {
    "url": "git+https://github.com/ThatzOkay/vue-aplayer.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/ThatzOkay/vue-aplayer/issues"
  },
  "keywords": [
    "player",
    "aplayer",
    "vue-aplayer",
    "music",
    "html5",
    "audio",
    "media"
  ],
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/aplayer.umd.js",
  "module": "./dist/aplayer.es.js",
  "typings": "dist/types/index.d.ts",
  "types": "dist/types/index.d.ts",
  "style": "dist/vue-aplayer.css",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "style": "./dist/vue-aplayer.css",
      "import": "./dist/aplayer.es.js",
      "require": "./dist/aplayer.umd.js"
    },
    "./dist/scss/*.scss": {
      "require": "./dist/scss/*.scss",
      "import": "./dist/scss/*.scss"
    }
  },
  "scripts": {
    "dev": "cross-env MODE=demo npm run vite",
    "vite": "vite",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:lib && npm run build:tsc",
    "build:lib": "cross-env MODE=lib vite build",
    "build:tsc": "vue-tsc --emitDeclarationOnly",
    "build:demo": "cross-env MODE=demo vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint ",
    "lint:fix": "eslint --fix ",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "hls.js": "^1.6.16",
    "music-metadata": "^11.12.3",
    "ua-parser-js": "^2.0.9",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.7.0",
    "classnames": "^2.5.1",
    "colorthief": "^2.7.0",
    "cross-env": "^7.0.3",
    "daisyui": "^5.5.19",
    "dayjs": "^1.11.20",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "fluid-tailwind": "^1.0.4",
    "globals": "^16.5.0",
    "postcss": "^8.5.9",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.4.2",
    "vite-plugin-static-copy": "^3.4.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.6"
  }
}
